    "seed": "node server/db/seed.js",
    "test": "node server/test_workflow.js",
    "test:workflow": "node server/test_workflow.js"
  },
  "keywords": [
    "gramseva",
    "panchayat",
    "civic-tech",
    "infrastructure-monitoring",
    "karnataka"
  ],
