  "description": "GramSeva: Proactive Village Infrastructure Monitoring & Resolution Platform (Honnur Gram Panchayat Pilot)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
